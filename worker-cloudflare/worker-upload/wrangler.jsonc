{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookme-api",
  "account_id": "4bc883fc791d8706160792e5f7b78b64",
  "compatibility_date": "2026-11-19",
  "main": "src/index.ts",
  // 远端资源仅在 --env dev 时绑定。
  "env": {
    "dev": {
      "name": "lookme-api-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "api.fudaixuexue.eu.cc",
          "custom_domain": true,
          "zone_id": "ad14ac2a1d1f349624f8008f963945dc"
        }
      ],
      "vars": {
        "PHOTO_ANALYSIS_ENABLED": true,
        "OUTBOX_BATCH_SIZE": 10,
        "OUTBOX_LEASE_SECONDS": 60,
        "OUTBOX_RETRY_BASE_SECONDS": 60,
        "OUTBOX_RETRY_MAX_SECONDS": 3600
      },
      "queues": {
        "producers": [
          {
            "binding": "IMAGE2TXT_QUEUE",
            "queue": "lookme-dev-image2txt"
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true
        }
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lookme-dev",
          "database_id": "8ca73bf2-a8d9-4d17-a393-105a9f63622d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PHOTOS", "bucket_name": "lookme-dev-photos" },
        { "binding": "COMICS", "bucket_name": "lookme-dev-comics" }
      ]
    }
  }
}
