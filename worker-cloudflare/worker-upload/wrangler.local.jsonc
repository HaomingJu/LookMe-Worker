{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookme-api-local",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-11-19",
  "main": "src/index.ts",
  // 仅供 --local 验证；此 ID 是占位符，不是远端数据库 ID。
  "vars": {
    "PHOTO_ANALYSIS_ENABLED": true,
    "OUTBOX_BATCH_SIZE": 10,
    "OUTBOX_LEASE_SECONDS": 60,
    "OUTBOX_RETRY_BASE_SECONDS": 60,
    "OUTBOX_RETRY_MAX_SECONDS": 3600
  },
  "queues": {
    "producers": [
      {
        "binding": "IMAGE2TXT_QUEUE",
        "queue": "lookme-local-image2txt"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lookme-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "lookme-dev-photos" },
    { "binding": "COMICS", "bucket_name": "lookme-dev-comics" }
  ]
}
