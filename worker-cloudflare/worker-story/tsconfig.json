{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["@cloudflare/workers-types"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowJs": true, "checkJs": true
  },
  "include": ["src/**/*.ts"]
}
