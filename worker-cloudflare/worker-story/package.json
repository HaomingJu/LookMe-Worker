{
  "name": "lookme-worker-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply lookme-dev --local --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "config:check": "node scripts/config.mjs check",
    "profiles:lock": "node scripts/config.mjs lock",
    "prebuild": "npm run config:check",
    "build": "wrangler deploy --env dev --dry-run",
    "predeploy:dev": "npm run config:check && npm run typecheck && npm test",
    "deploy:dev": "wrangler deploy --env dev",
    "story": "node scripts/story.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261119.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261118.0-beta",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.165.0"
  }
}
