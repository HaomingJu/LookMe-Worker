{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookme-story",
  "account_id": "4bc883fc791d8706160792e5f7b78b64",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  // 独立 HTTP Worker：没有 Cron、Queue、R2，也不加入现有自动部署管道。
  // dev 使用独立故事域名；首次绑定与真实模型调用已分别确认。
  "env": {
    "dev": {
      "name": "lookme-story-dev",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{
        "pattern": "story.fudaixuexue.eu.cc",
        "custom_domain": true,
        "zone_id": "ad14ac2a1d1f349624f8008f963945dc"
      }],
      "vars": { "STORY_GENERATION_ENABLED": true },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "enabled": true, "invocation_logs": true }
      },
      "ai": { "binding": "AI" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "lookme-dev",
        "database_id": "8ca73bf2-a8d9-4d17-a393-105a9f63622d",
        "migrations_dir": "../worker-upload/migrations"
      }]
    }
  }
}
