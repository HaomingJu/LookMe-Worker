{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookme-comic-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "COMIC_GENERATION_ENABLED": false,
    "COMIC_FLARE_ENABLED": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lookme-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../worker-upload/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "lookme-dev-photos"
    },
    {
      "binding": "COMICS",
      "bucket_name": "lookme-dev-comics"
    }
  ]
}
