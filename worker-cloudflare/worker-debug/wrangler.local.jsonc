{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lookme-debug-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/public/*.js"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lookme-debug-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../worker-upload/migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "lookme-debug-local-photos" },
    { "binding": "COMICS", "bucket_name": "lookme-debug-local-comics" }
  ]
}
